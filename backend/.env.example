NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/healthhub
JWT_ACCESS_SECRET=replace_with_secure_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_secure_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_FOLDER=medivault_records

# AI Provider: mock | openai | gemini
AI_PROVIDER=mock
AI_API_KEY=
OCR_PROVIDER=mock
OCR_API_KEY=

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini (if AI_PROVIDER=gemini)
GEMINI_API_KEY=
